{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "./dist",
    // Deliberately *outside* dist/: `files: ["dist"]` would otherwise publish
    // 42 kB of incremental-build metadata to npm. Already gitignored.
    "tsBuildInfoFile": "./.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
