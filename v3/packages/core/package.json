{
  "name": "@green-tunnel/core",
  "version": "3.0.0",
  "description": "GreenTunnel engine — DPI-evading TCP proxy with TLS fragmentation and encrypted DNS",
  "license": "MIT",
  "author": "Sadegh Hayeri",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "dev": "tsc --build tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "dns-packet": "^5.6.1",
    "lru-cache": "^11.5.2"
  },
  "devDependencies": {
    "@types/dns-packet": "^5.6.5"
  }
}
