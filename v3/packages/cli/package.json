      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build && node dist/main.js",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@green-tunnel/core": "3.0.0"
  }
